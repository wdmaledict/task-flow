    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login successful - redirected to board\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.include(\"Project Board\");",
                  "});",
                  "",
                  "pm.test(\"Session cookie was set\", function () {",
                  "    pm.expect(pm.cookies.has(\"PHPSESSID\")).to.be.true;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
